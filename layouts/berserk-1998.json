{
  "id": "root",
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "crest",
          "type": "block",
          "content": {
            "mod": "iron-eclipse"
          },
          "size": {
            "px": 172
          },
          "padding": [
            8,
            0
          ],
          "window_drag": true
        },
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "iron-chrome"
          },
          "size": {
            "px": 46
          }
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "iron-spaces"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            },
            {
              "id": "agents",
              "type": "block",
              "content": {
                "mod": "iron-agents"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "iron-chrome",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 69
          }
        }
      ],
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": {
        "image": "mods/iron-eclipse/art/sidebar-v6.png",
        "fit": "cover"
      },
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "iron-tabs"
          },
          "size": {
            "px": 42
          },
          "window_drag": true
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "iron-pane"
                    },
                    "reveal": "always",
                    "height": 30,
                    "position": "top"
                  },
                  "background": {
                    "image": "mods/iron-eclipse/art/field-v4.png",
                    "fit": "cover"
                  },
                  "border": {
                    "width": 1,
                    "color": "#3a2a22"
                  },
                  "focus": {
                    "width": 2,
                    "color": "#a3201b"
                  },
                  "radius": 2,
                  "gap": 10,
                  "lone": true
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    },
                    {
                      "id": "missions",
                      "type": "block",
                      "content": {
                        "mod": "missions"
                      }
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "hidden": true,
              "background": "surface",
              "border": {
                "width": 1,
                "color": "border"
              },
              "radius": 2
            }
          ],
          "background": {
            "gradient": [
              "#2a0c0a",
              "#0a0807"
            ],
            "angle": 180
          },
          "padding": 10,
          "gap": 10
        },
        {
          "id": "status",
          "type": "block",
          "content": {
            "mod": "workspace-status"
          },
          "size": {
            "px": 28
          }
        }
      ],
      "resizable": false
    }
  ],
  "background": "canvas",
